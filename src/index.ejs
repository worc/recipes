<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="theme-color" content="#68bdd4">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect x='1' y='1' width='14' height='14' fill='%23fbfbf8' stroke='%231c1f22' stroke-width='1.5'/%3E%3Cpath d='M1 9 L9 1 M1 15 L15 1 M7 15 L15 7' stroke='%2368bdd4' stroke-width='1.6'/%3E%3C/svg%3E">
<% if (url) { %>
    <link rel="canonical" href="<%= url %>">
    <meta property="og:url" content="<%= url %>">
<% } %>
    <meta property="og:site_name" content="recipes · stxalq.dev">
    <meta property="og:type" content="<%= type %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta name="twitter:card" content="summary">
    <link rel="stylesheet" href="/<%= css %>">
  </head>

  <body>
    <div id="app"></div>
    <script id="page-summaries" type="application/json"><%- summaries %></script>
    <script src="/<%= index %>"></script>
  </body>
</html>
